---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Oltpay",
  description = "Beli pulsa, paket data, dan produk PPOB lainnya dengan harga terbaik dan proses cepat.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/logos/oltpay_logo.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Load font — di head bukan @import agar tidak double-block -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>